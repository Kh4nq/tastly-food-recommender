/MLAI.zip
/ai2_sft_v1.zip
/data/data.zip
/data/ai1-v3-artifacts.zip
/data/ai1-demo-data.zip
# Provisioning staging and retained manual-recovery copies contain AI1 data.
/data/.ai1-provision-*/
/data/backups/

.venv311/
.venv-*/
/repo_tree.txt
/repo_files.txt
tmp_dataset_v3/

# Next.js build output at any depth (src/frontend/.gitignore only covers its own root).
# A stray `next dev` run from the wrong folder leaves a copy elsewhere.
.next/


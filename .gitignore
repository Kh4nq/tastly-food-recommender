data/ai2_interactive/

# Private interactive records remain ignored; retain only the directory marker.
!data/ai2_interactive/
data/ai2_interactive/*
!data/ai2_interactive/.gitkeep

# Temporary/smoke/batch labeling directories.
data/ai2_labeling_*/

# Private AI2 labeling artifacts, including journals, reviews and exports.
data/ai2_labeling/**
!data/ai2_labeling/**/
!data/ai2_labeling/**/.gitkeep

# Large artifacts stay external; fixtures under tests/data remain trackable.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
data/embeddings/**
!data/embeddings/**/
!data/embeddings/**/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
.ipynb_checkpoints/
.cache/

# Model metadata/config is intended to be tracked; binary weights are not.
models/**/*.bin
models/**/*.pkl
models/**/*.joblib

# Ignore all local AI2 model/training artifacts by default
models/ai2/**

# Optional Qwen configuration is public; weights/tokenizers are external.
!models/ai2/ai2-qwen3-1.7b-lora-targeted-v3/
!models/ai2/ai2-qwen3-1.7b-lora-targeted-v3/README.md
!models/ai2/ai2-qwen3-1.7b-lora-targeted-v3/adapter_config.json
!models/ai2/ai2-qwen3-1.7b-lora-targeted-v3/chat_template.jinja


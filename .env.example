# Public website: OpenRouter LLM-first chain. Add your own backend-only key.
# The integration demo and tests stay offline regardless of this example.
LLM_PROVIDER=openrouter_chain

GEMINI_API_KEY=
GEMINI_MODEL=

# Optional legacy provider only: manually install .[openai] to use it.
# Normal setup requires neither OPENAI_API_KEY nor OPENAI_MODEL.
# OPENAI_API_KEY=
# OPENAI_MODEL=

LOCAL_SLM_ENABLED=false
LOCAL_SLM_BACKEND=qwen_lora
LOCAL_SLM_BASE_MODEL=Qwen/Qwen3-1.7B
LOCAL_SLM_ADAPTER_VERSION=v3
# v4 selects models/ai2/best_adapter_v4_experimental; v3 is the rollback default.
# An explicit path overrides the version selector. Leave it unset to use VERSION.
# LOCAL_SLM_ADAPTER_PATH=models/ai2/ai2-qwen3-1.7b-lora-targeted-v3
LOCAL_SLM_LOCAL_FILES_ONLY=true
LOCAL_SLM_MAX_NEW_TOKENS=512
# Legacy setting retained for compatibility; Qwen uses BASE_MODEL and ADAPTER_PATH.
LOCAL_SLM_MODEL=
LOCAL_SLM_MIN_CONFIDENCE=0.80

# Cloud chain selected above; live requests require your own key/account.
# Keep this key on the backend; never use a NEXT_PUBLIC_ variable for it.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_BACKUP_MODEL=openai/gpt-5.4-mini
OPENROUTER_CHAIN_MAX_TOKENS=512
OPENROUTER_TIMEOUT=30
# One structured interpretation supplies intent, preference delta and reply.
AI2_LLM_FIRST_ENABLED=true
# Rules are optional and run only after failed model fallbacks in this mode.
AI2_RULE_FALLBACK_ENABLED=false
# Used only after both cloud models fail AND LOCAL_SLM_ENABLED=true.
LOCAL_SLM_FALLBACK_ADAPTER_PATH=models/ai2/best_adapter_v4_experimental
# Two providers may each use the timeout above, followed by retrieval/map lookup.
# For manual chain testing, set BACKEND_AI_TIMEOUT_S=120 in the server environment.

# Keep AI1's query encoder off the GPU used by Qwen. Does not rebuild embeddings.
AI1_EMBEDDING_DEVICE=cpu

CONVERSATION_LOG_ENABLED=false
CONVERSATION_LOG_PATH=logs/conversation.jsonl

# Optional PostgreSQL backend; not needed by the direct AI2 -> AI1 -> AI3 pipeline.
# setup.ps1 -WithDatabase uses these Compose settings. Keep DATABASE_URL in sync.
POSTGRES_DB=mlai_food
POSTGRES_USER=mlai
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mlai:change_me@localhost:5432/mlai_food


# Backend API (src/backend). Everything below is optional: the values shown are the defaults.
# Put comments on their own line: a trailing "# ..." would become part of the value.
# BACKEND_CORS_ORIGINS=http://localhost:3000
# BACKEND_COOKIE_SECURE=false
# BACKEND_AI_CONCURRENCY=2
# BACKEND_WARMUP=true
BACKEND_AI_TIMEOUT_S=120

# Accounts: sessions, lock after repeated wrong passwords, and per-IP abuse limits.
# BACKEND_AUTH_SESSION_DAYS=7
# BACKEND_AUTH_MAX_FAILURES=5
# BACKEND_AUTH_LOCK_MINUTES=15
# BACKEND_AUTH_HASH_CONCURRENCY=4
# BACKEND_AUTH_HASH_QUEUE_TIMEOUT_S=2
# Per-IP limits. Behind the Next rewrite all visitors share one IP, so keep these generous.
# BACKEND_AUTH_RATE_BURST=30
# BACKEND_AUTH_RATE_PER_MINUTE=60
# Read X-Forwarded-For only when the backend sits behind a proxy you control.
# BACKEND_TRUST_PROXY=false
